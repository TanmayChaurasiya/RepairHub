{
  "name": "RepairHub",
  "short_name": "RepairHub",
  "description": "Vehicle Repair and Service Management Platform",
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0f172a",
  "background_color": "#ffffff",
