# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Note: For Docker default, port is 5432; for local dedicated cluster, port is 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/repairhub?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="repairhub_super_secret_access_jwt_key_2026_secure"
JWT_REFRESH_SECRET="repairhub_super_secret_refresh_jwt_key_2026_secure"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:3000"
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# File Storage
UPLOAD_DIR="./uploads"

# Payment Provider Mode (MOCK / RAZORPAY)
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email Configuration (Nodemailer / Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="RepairHub <your-email@gmail.com>"
FRONTEND_URL="http://localhost:3000"

# Master Admin Exclusive Configuration
MASTER_ADMIN_EMAIL="mrbindastanmay@gmail.com"
MASTER_ADMIN_INITIAL_PASSWORD=""
