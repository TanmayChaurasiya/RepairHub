datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  MECHANIC
  ADMIN
  GARAGE
}

enum GarageStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MechanicStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum VehicleType {
  TWO_WHEELER
  CAR
  COMMERCIAL
}

enum RepairCategory {
  ENGINE
  BRAKES
  ELECTRICAL
  AC
  SUSPENSION
  GENERAL_SERVICE
  BODYWORK
}

enum RequestStatus {
  SUBMITTED
  ASSIGNED
  INSPECTING
  ESTIMATE_SENT
  APPROVED
  REJECTED
  IN_PROGRESS
  QC
  COMPLETED
  PAID
  CANCELLED
}

enum EstimateStatus {
  SENT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum EstimateItemKind {
  LABOUR
  PART
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  name                String
  phone               String
  role                Role             @default(CUSTOMER)
  failedLoginAttempts Int              @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  mechanicProfile     MechanicProfile?
  vehicles            Vehicle[]
  customerRequests    RepairRequest[]  @relation("CustomerRequests")
  mechanicRequests    RepairRequest[]  @relation("MechanicRequests")
  statusHistories     StatusHistory[]
  reviews             Review[]
  complaints          Complaint[]      @relation("CustomerComplaints")
  resolvedComplaints  Complaint[]      @relation("AdminResolvedComplaints")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ownedGarage         Garage?          @relation("GarageOwner")
  auditLogs           AuditLog[]
}

model Garage {
  id              String               @id @default(uuid())
  name            String
  address         String
  city            String
  state           String?
  pinCode         String?
  phone           String
  description     String?
  operatingHours  String?
  services        String[]             @default([])
  isVerified      Boolean              @default(false)
  status          GarageStatus         @default(PENDING)
  rejectionReason String?
  ownerId         String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  owner           User?                @relation("GarageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  mechanics       MechanicProfile[]
  requests        RepairRequest[]
  invitations     MechanicInvitation[]

  @@index([status])
  @@index([city])
}

model MechanicProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  garageId        String
  skills          String[]
  specialization  String?
  experienceYears Int            @default(0)
  available       Boolean        @default(true)
  status          MechanicStatus @default(ACTIVE)
  rejectionReason String?
  rating          Float          @default(5.0)
  totalReviews    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  garage          Garage         @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([status])
}

model Vehicle {
  id         String          @id @default(uuid())
  customerId String
  type       VehicleType
  make       String
  model      String
  year       Int
  regNo      String          @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  customer   User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requests   RepairRequest[]
}

model RepairRequest {
  id            String          @id @default(uuid())
  requestNumber String          @unique
  customerId    String
  vehicleId     String
  garageId      String
  mechanicId    String?
  category      RepairCategory
  description   String
  diagnosis     String?
  photos        String[]        @default([])
  status        RequestStatus   @default(SUBMITTED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  customer      User            @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  garage        Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  mechanic      User?           @relation("MechanicRequests", fields: [mechanicId], references: [id], onDelete: SetNull)
  statusHistory StatusHistory[]
  estimates     Estimate[]
  invoice       Invoice?
  payment       Payment?
  review        Review?
  complaints    Complaint[]

  @@index([status])
  @@index([customerId])
  @@index([mechanicId])
  @@index([garageId])
}

model StatusHistory {
  id         String         @id @default(uuid())
  requestId  String
  fromStatus RequestStatus?
  toStatus   RequestStatus
  actorId    String
  actorRole  Role
  note       String?
  createdAt  DateTime       @default(now())

  request    RepairRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Estimate {
  id           String         @id @default(uuid())
  requestId    String
  version      Int            @default(1)
  status       EstimateStatus @default(SENT)
  totalPaise   Int            @default(0)
  customerNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  request      RepairRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  items        EstimateItem[]

  @@index([requestId])
}

model EstimateItem {
  id             String           @id @default(uuid())
  estimateId     String
  kind           EstimateItemKind
  description    String
  quantity       Int              @default(1)
  unitPricePaise Int
  totalPaise     Int

  estimate       Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model Invoice {
  id            String        @id @default(uuid())
  requestId     String        @unique
  invoiceNumber String        @unique
  totalPaise    Int
  pdfPath       String?
  createdAt     DateTime      @default(now())

  request       RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  payment       Payment?
}

model Payment {
  id            String        @id @default(uuid())
  requestId     String        @unique
  invoiceId     String        @unique
  amountPaise   Int
  provider      String        @default("MOCK")
  transactionId String        @unique
  status        PaymentStatus @default(SUCCESS)
  createdAt     DateTime      @default(now())

  request       RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Review {
  id         String        @id @default(uuid())
  requestId  String        @unique
  customerId String
  rating     Int
  comment    String
  createdAt  DateTime      @default(now())

  request    RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer   User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Complaint {
  id             String          @id @default(uuid())
  requestId      String
  customerId     String
  subject        String
  description    String
  status         ComplaintStatus @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  request        RepairRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer       User            @relation("CustomerComplaints", fields: [customerId], references: [id], onDelete: Cascade)
  resolvedBy     User?           @relation("AdminResolvedComplaints", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([customerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MechanicInvitation {
  id         String    @id @default(uuid())
  garageId   String
  email      String
  name       String
  phone      String
  skills     String[]
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  garage     Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([email])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actorRole    Role
  action       String
  targetEntity String
  targetId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([targetEntity, targetId])
  @@index([createdAt])
}
