datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  MECHANIC
  ADMIN
  GARAGE
}

enum GarageStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MechanicStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum MechanicAvailability {
  AVAILABLE
  BUSY
  OFFLINE
  ON_BREAK
}

enum EmailNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum EmailNotificationType {
  VEHICLE_AVAILABILITY_AVAILABLE
  VEHICLE_AVAILABILITY_UNAVAILABLE
  MECHANIC_ASSIGNED
  MECHANIC_REASSIGNED
  GARAGE_APPROVAL
  GARAGE_REJECTION
  GENERAL
  MECHANIC_CURRENTLY_BUSY
  NO_QUALIFIED_MECHANIC
}

enum PowertrainType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
  OTHER
}

enum VehicleType {
  TWO_WHEELER
  CAR
  COMMERCIAL
}

enum RepairCategory {
  ENGINE
  BRAKES
  ELECTRICAL
  AC
  SUSPENSION
  GENERAL_SERVICE
  BODYWORK
}

enum EmergencyCategory {
  FLAT_TYRE
  BATTERY_FAILURE
  ENGINE_OVERHEATING
  VEHICLE_BREAKDOWN
  ENGINE_PROBLEMS
  FUEL_PROBLEMS
  TOWING
  OTHER
}

enum EmergencyStatus {
  REQUESTED
  SEARCHING
  PENDING_ACCEPTANCE
  ACCEPTED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  UNFULFILLED
}

enum RequestStatus {
  SUBMITTED
  ASSIGNED
  INSPECTING
  ESTIMATE_SENT
  APPROVED
  REJECTED
  IN_PROGRESS
  QC
  COMPLETED
  PAID
  CANCELLED
}

enum EstimateStatus {
  SENT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum EstimateItemKind {
  LABOUR
  PART
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  name                String
  phone               String
  role                Role             @default(CUSTOMER)
  failedLoginAttempts Int              @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  mechanicProfile     MechanicProfile?
  vehicles            Vehicle[]
  customerRequests          RepairRequest[]      @relation("CustomerRequests")
  mechanicRequests          RepairRequest[]      @relation("MechanicRequests")
  customerEmergencyRequests EmergencyRequest[]   @relation("CustomerEmergencyRequests")
  mechanicEmergencyRequests EmergencyRequest[]   @relation("MechanicEmergencyRequests")
  statusHistories           StatusHistory[]
  reviews                   Review[]
  complaints                Complaint[]          @relation("CustomerComplaints")
  resolvedComplaints        Complaint[]          @relation("AdminResolvedComplaints")
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  ownedGarage               Garage?              @relation("GarageOwner")
  auditLogs                 AuditLog[]
  previousAssignments       AssignmentHistory[]  @relation("PreviousMechanicAssignments")
  newAssignments            AssignmentHistory[]  @relation("NewMechanicAssignments")
  assignedHistories         AssignmentHistory[]  @relation("AssignedByHistories")
}

model Garage {
  id                String               @id @default(uuid())
  name              String
  address           String
  city              String
  state             String?
  pinCode           String?
  phone             String
  description       String?
  operatingHours    String?
  services          String[]             @default([])
  supportedVehicleTypes VehicleType[]    @default([CAR, TWO_WHEELER, COMMERCIAL])
  supportedPowertrains  PowertrainType[] @default([PETROL, DIESEL, ELECTRIC, HYBRID, CNG, OTHER])
  latitude          Float?               @default(26.4735)
  longitude         Float?               @default(80.3075)
  acceptsEmergency  Boolean              @default(true)
  emergencyRadiusKm Float                @default(25.0)
  emergencyPhone    String?
  isVerified        Boolean              @default(false)
  status            GarageStatus         @default(PENDING)
  rejectionReason   String?
  ownerId           String?              @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  owner             User?                @relation("GarageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  mechanics         MechanicProfile[]
  requests          RepairRequest[]
  emergencyRequests EmergencyRequest[]
  invitations       MechanicInvitation[]

  @@index([status])
  @@index([city])
}

model MechanicProfile {
  id                       String               @id @default(uuid())
  userId                   String               @unique
  garageId                 String
  skills                   String[]
  specialization           String?
  skillsPendingReview      Boolean              @default(false)
  experienceYears          Int                  @default(0)
  available                Boolean              @default(true)
  availability             MechanicAvailability @default(AVAILABLE)
  breakReason              String?
  lastActiveAt             DateTime?            @default(now())
  latitude                 Float?               @default(26.4735)
  longitude                Float?               @default(80.3075)
  acceptsEmergency         Boolean              @default(true)
  emergencyServiceRadiusKm Float                @default(20.0)
  status                   MechanicStatus       @default(ACTIVE)
  rejectionReason          String?
  rating                   Float                @default(5.0)
  totalReviews             Int                  @default(0)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  garage                   Garage               @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([status])
}

model Vehicle {
  id                 String              @id @default(uuid())
  customerId         String
  type               VehicleType
  make               String
  model              String
  year               Int
  powertrain         PowertrainType      @default(PETROL)
  fuelType           String?             @default("PETROL")
  regNo              String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  customer           User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requests           RepairRequest[]
  emergencyRequests  EmergencyRequest[]
  emailNotifications EmailNotification[]
}

model RepairRequest {
  id            String          @id @default(uuid())
  requestNumber String          @unique
  customerId    String
  vehicleId     String
  garageId      String
  mechanicId    String?
  category      RepairCategory
  description   String
  diagnosis     String?
  photos        String[]        @default([])
  status        RequestStatus   @default(SUBMITTED)
  eligibilityStatus    String?
  unavailabilityReason String?
  requiredSkills       String[]        @default([])
  estimatedWaitMinutes Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  customer      User            @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  garage        Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)
  mechanic      User?           @relation("MechanicRequests", fields: [mechanicId], references: [id], onDelete: SetNull)
  statusHistory StatusHistory[]
  estimates     Estimate[]
  invoice       Invoice?
  payment       Payment?
  review              Review?
  complaints          Complaint[]
  assignmentHistories AssignmentHistory[]
  emailNotifications  EmailNotification[]

  @@index([status])
  @@index([customerId])
  @@index([mechanicId])
  @@index([garageId])
}

model StatusHistory {
  id         String         @id @default(uuid())
  requestId  String
  fromStatus RequestStatus?
  toStatus   RequestStatus
  actorId    String
  actorRole  Role
  note       String?
  createdAt  DateTime       @default(now())

  request    RepairRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Estimate {
  id           String         @id @default(uuid())
  requestId    String
  version      Int            @default(1)
  status       EstimateStatus @default(SENT)
  totalPaise   Int            @default(0)
  customerNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  request      RepairRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  items        EstimateItem[]

  @@index([requestId])
}

model EstimateItem {
  id             String           @id @default(uuid())
  estimateId     String
  kind           EstimateItemKind
  description    String
  quantity       Int              @default(1)
  unitPricePaise Int
  totalPaise     Int

  estimate       Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model Invoice {
  id            String        @id @default(uuid())
  requestId     String        @unique
  invoiceNumber String        @unique
  totalPaise    Int
  pdfPath       String?
  createdAt     DateTime      @default(now())

  request       RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  payment       Payment?
}

model Payment {
  id            String        @id @default(uuid())
  requestId     String        @unique
  invoiceId     String        @unique
  amountPaise   Int
  provider      String        @default("MOCK")
  transactionId String        @unique
  status        PaymentStatus @default(SUCCESS)
  createdAt     DateTime      @default(now())

  request       RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Review {
  id         String        @id @default(uuid())
  requestId  String        @unique
  customerId String
  rating     Int
  comment    String
  createdAt  DateTime      @default(now())

  request    RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer   User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Complaint {
  id             String          @id @default(uuid())
  requestId      String
  customerId     String
  subject        String
  description    String
  status         ComplaintStatus @default(OPEN)
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  request        RepairRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer       User            @relation("CustomerComplaints", fields: [customerId], references: [id], onDelete: Cascade)
  resolvedBy     User?           @relation("AdminResolvedComplaints", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([customerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MechanicInvitation {
  id         String    @id @default(uuid())
  garageId   String
  email      String
  name       String
  phone      String
  skills     String[]
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  garage     Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([email])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actorRole    Role
  action       String
  targetEntity String
  targetId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([targetEntity, targetId])
  @@index([createdAt])
}

model AssignmentHistory {
  id                 String        @id @default(uuid())
  requestId          String
  previousMechanicId String?
  newMechanicId      String?
  assignedById       String
  assignedByRole     Role          @default(ADMIN)
  action             String        @default("ASSIGNED")
  checkResult        String?
  reason             String
  createdAt          DateTime      @default(now())

  request            RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  previousMechanic   User?         @relation("PreviousMechanicAssignments", fields: [previousMechanicId], references: [id], onDelete: SetNull)
  newMechanic        User?         @relation("NewMechanicAssignments", fields: [newMechanicId], references: [id], onDelete: SetNull)
  assignedBy         User          @relation("AssignedByHistories", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([assignedById])
  @@index([newMechanicId])
  @@index([createdAt])
}

model IssueSkillMapping {
  id             String          @id @default(uuid())
  category       RepairCategory
  powertrain     PowertrainType?
  issuePattern   String?
  requiredSkills String[]
  priority       Int             @default(0)
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([category])
  @@index([powertrain])
  @@index([isActive])
}

model EmailNotification {
  id           String                  @id @default(uuid())
  recipient    String
  subject      String
  template     String
  status       EmailNotificationStatus @default(PENDING)
  type         EmailNotificationType   @default(GENERAL)
  vehicleId    String?
  requestId    String?
  metadata     Json?
  errorDetails String?
  sentAt       DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  vehicle      Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  request      RepairRequest?          @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([recipient])
  @@index([status])
  @@index([type])
  @@index([vehicleId])
  @@index([createdAt])
}

model EmergencyRequest {
  id                       String            @id @default(uuid())
  requestNumber            String            @unique
  customerId               String
  vehicleId                String
  garageId                 String?
  assignedMechanicId       String?
  category                 EmergencyCategory
  description              String
  photos                   String[]          @default([])
  status                   EmergencyStatus   @default(REQUESTED)
  pickupLatitude           Float
  pickupLongitude          Float
  pickupAddress            String
  mechanicLatitude         Float?
  mechanicLongitude        Float?
  mechanicLocationUpdatedAt DateTime?
  searchRadiusKm           Float             @default(15.0)
  estimatedDistanceKm      Float?
  estimatedDurationMinutes Int?
  baseChargePaise          Int               @default(49900)
  totalPaidPaise           Int               @default(0)
  acceptedAt               DateTime?
  enRouteAt                DateTime?
  arrivedAt                DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  interventionReason       String?
  declinedMechanicIds      String[]          @default([])
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  customer                 User              @relation("CustomerEmergencyRequests", fields: [customerId], references: [id], onDelete: Cascade)
  vehicle                  Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  garage                   Garage?           @relation(fields: [garageId], references: [id], onDelete: SetNull)
  assignedMechanic         User?             @relation("MechanicEmergencyRequests", fields: [assignedMechanicId], references: [id], onDelete: SetNull)
  assignmentHistories      EmergencyAssignmentHistory[]
  statusHistories          EmergencyStatusHistory[]

  @@index([status])
  @@index([customerId])
  @@index([assignedMechanicId])
  @@index([garageId])
  @@index([createdAt])
}

model EmergencyAssignmentHistory {
  id                 String           @id @default(uuid())
  emergencyRequestId String
  mechanicId         String
  garageId           String?
  action             String           // OFFERED, ACCEPTED, DECLINED, REASSIGNED, TIMEOUT, CANCELLED
  reason             String?
  actorId            String?
  createdAt          DateTime         @default(now())

  emergencyRequest   EmergencyRequest @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)

  @@index([emergencyRequestId])
  @@index([mechanicId])
  @@index([createdAt])
}

model EmergencyStatusHistory {
  id                 String           @id @default(uuid())
  emergencyRequestId String
  fromStatus         EmergencyStatus?
  toStatus           EmergencyStatus
  actorId            String
  note               String?
  createdAt          DateTime         @default(now())

  emergencyRequest   EmergencyRequest @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)

  @@index([emergencyRequestId])
  @@index([createdAt])
}
